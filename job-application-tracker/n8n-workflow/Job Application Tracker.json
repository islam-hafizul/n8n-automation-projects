    {
      "parameters": {
        "jsCode": "const allowedStatuses = [\n  'Applied',\n  'Interview',\n  'Technical Test',\n  'Offer',\n  'Rejected',\n  'Withdrawn'\n];\n\nconst allowedPriorities = [\n  'Low',\n  'Medium',\n  'High'\n];\n\nreturn items\n  .filter(item => {\n    const processingStatus =\n      String(item.json.processing_status || '')\n        .trim()\n        .toLowerCase();\n\n    return processingStatus === 'new';\n  })\n  .map(item => {\n    const data = item.json;\n\n    const company = String(data.company || '').trim();\n    const position = String(data.position || '').trim();\n    const jobDescription =\n      String(data.job_description || '').trim();\n\n    if (!company) {\n      throw new Error(\n        `Missing company name for application ID ${data.id}`\n      );\n    }\n\n    if (!position) {\n      throw new Error(\n        `Missing position for application ID ${data.id}`\n      );\n    }\n\n    if (!jobDescription) {\n      throw new Error(\n        `Missing job description for application ID ${data.id}`\n      );\n    }\n\n    const status = allowedStatuses.includes(data.status)\n      ? data.status\n      : 'Applied';\n\n    const priority = allowedPriorities.includes(data.priority)\n      ? data.priority\n      : 'Medium';\n\n    return {\n      json: {\n        id: Number(data.id),\n        date_applied: data.date_applied || '',\n\n        company,\n        position,\n        job_description: jobDescription,\n        job_url: String(data.job_url || '').trim(),\n\n        status,\n        priority,\n\n        current_category:\n          String(data.category || '').trim(),\n\n        current_experience_level:\n          String(data.experience_level || '').trim(),\n\n        current_required_skills:\n          String(data.required_skills || '').trim(),\n\n        current_preferred_skills:\n          String(data.preferred_skills || '').trim(),\n\n        current_application_notes:\n          String(data.application_notes || '').trim(),\n\n        current_ai_recommendations:\n          String(data.ai_recommendations || '').trim(),\n\n        follow_up_date:\n          data.follow_up_date || '',\n\n        processing_status: 'New'\n      }\n    };\n  });"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "7da362ab-ffe2-48c5-83de-a428e3d56adf",
      "name": "Data Normalization"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-5-mini",
          "mode": "list",
          "cachedResultName": "GPT-5-MINI"
        },
        "responses": {
          "values": [
            {
              "content": "=You are a job application assistant.\n\nAnalyze the following job posting and extract structured information.\n\nCompany:\n{{ $json.company }}\n\nPosition:\n{{ $json.position }}\n\nJob Description:\n{{ $json.job_description }}\n\nRules:\n\n1. Identify the job category.\n2. Identify the expected experience level.\n3. Extract explicitly mentioned required skills.\n4. Extract explicitly mentioned preferred or nice-to-have skills.\n5. Write a concise summary of the role.\n6. Provide practical recommendations for applying to this position.\n\nDo not invent skills, requirements, qualifications, or technologies that are not supported by the job description.\n\nFor skills:\n- Only include a skill if the job description explicitly mentions it.\n- Do not infer equivalent technologies.\n- Keep required and preferred skills separate.\n\nReturn only the requested structured information."
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "schema": "{\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\"\n    },\n    \"experience_level\": {\n      \"type\": \"string\"\n    },\n    \"required_skills\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"preferred_skills\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"recommendations\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"category\",\n    \"experience_level\",\n    \"required_skills\",\n    \"preferred_skills\",\n    \"summary\",\n    \"recommendations\"\n  ]\n}"
            }
          }
        }
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        448,
        0
      ],
      "id": "6a5bedd5-fbc4-49e7-b16a-09079159fb9b",
      "name": "Message a model",
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": ""
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const data = item.json;\n\n  const result = data.output?.[0]?.content?.[0]?.text;\n\n  if (!result) {\n    throw new Error('OpenAI returned no analysis result.');\n  }\n\n  return {\n    json: {\n      id: $('Data Normalization').first().json.id,\n\n      category: result.category || '',\n      experience_level: result.experience_level || '',\n\n      required_skills:\n        Array.isArray(result.required_skills)\n          ? result.required_skills.join(', ')\n          : '',\n\n      preferred_skills:\n        Array.isArray(result.preferred_skills)\n          ? result.preferred_skills.join(', ')\n          : '',\n\n      application_notes: result.summary || '',\n\n      ai_recommendations:\n        Array.isArray(result.recommendations)\n          ? result.recommendations.join(' | ')\n          : '',\n\n      processing_status: 'Processed'\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
